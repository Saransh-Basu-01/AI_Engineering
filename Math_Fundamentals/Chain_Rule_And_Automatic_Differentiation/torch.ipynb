   ],
   "source": [
    "import torch\n",
    "\n",
    "x1 = torch.tensor(2.0, requires_grad=True)\n",
    "x2 = torch.tensor(3.0, requires_grad=True)\n",
    "a = x1 * x2\n",
    "b = a + 1.0\n",
    "y = torch.relu(b)\n",
    "y.backward()\n",
    "\n",
    "print(f\"PyTorch dy/dx1 = {x1.grad.item()}\")  # 3.0\n",
    "print(f\"PyTorch dy/dx2 = {x2.grad.item()}\")  # 2.0"
   ]
  }
 ],
