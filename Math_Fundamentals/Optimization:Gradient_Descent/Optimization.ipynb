   "source": [
    "def rosenbrock(params):\n",
    "    x,y=params\n",
    "    return (1-x)**2 +100*(y-(x)**2)**2"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "a1726933",
   "metadata": {},
   "outputs": [],
   "source": [
    "def rosenbrock_gradient(params):\n",
    "    x,y=params\n",
    "    df_dx=-2*(1-x) + 200 * (y-x**2)*(-2*x)\n",
    "    df_dy=200*(y-x**2)\n",
    "    return [df_dx,df_dy]"
   ]
